@page "/orders/{Id:int}"
@attribute [Authorize]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Orders
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients.Orders
@using Microsoft.AspNetCore.Authorization


@inject OrdersApiClient ApiClient
@inject CurrencyFormatter Currency

<ErrorToast Message="@ErrorMessage" />

@if (_order is null) {
    <PageTitle>Order - BikeShop</PageTitle>
    <PageHeader Text="Order" />
    <LoadingSpinner />
}
else {
    <PageTitle>Order #@_order.Id - BikeShop</PageTitle>
    <PageHeader Text="@($"Order #{_order.Id}")" />

    <div class="container my-5">
        <section class="order-overview card">
            <div class="order-overview-header">
                <div>
                    <span class="order-caption">
                        Current status
                    </span>

                    <span class="@GetStatusClass(_order.Status)">
                        @_order.Status
                    </span>
                </div>

                <div class="order-created">
                    <span class="order-caption">
                        Created
                    </span>

                    <strong>
                        @_order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </strong>
                </div>
            </div>

            <hr />

            <div class="order-information">
                <div class="information-item">
                    <span class="information-icon">
                        <i class="bi bi-calendar-event"></i>
                    </span>

                    <div>
                        <span class="order-caption">
                            Delivery
                        </span>

                        <strong>
                            @_order.DeliveryAt.ToString(
                            "dd.MM.yyyy HH:mm")
                    </strong>
                </div>
            </div>

            <div class="information-item">
                <span class="information-icon">
                    <i class="bi bi-telephone"></i>
                </span>

                <div>
                    <span class="order-caption">
                        Customer phone
                    </span>

                    <strong>@_order.CustomerPhone</strong>
                </div>
            </div>

            <div class="information-item">
                <span class="information-icon">
                    <i class="bi bi-geo-alt"></i>
                </span>

                <div>
                    <span class="order-caption">
                        Delivery address
                    </span>

                    <strong>@_order.DeliveryAddress</strong>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_order.CourierPhone)) {
                    <div class="information-item">
                        <span class="information-icon">
                            <i class="bi bi-person-badge"></i>
                        </span>

                        <div>
                            <span class="order-caption">
                                Courier phone
                            </span>

                            <strong>@_order.CourierPhone</strong>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="order-items card">
            <div class="order-items-header">
                <h2>Order items</h2>

                <span>
                    @_order.Items.Sum(x => x.Quantity) products
                </span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in _order.Items) {
                            <tr>
                                <td>
                                    <strong>@item.ProductName</strong>
                                </td>

                                <td class="text-end">
                                    @Currency.Format(item.UnitPrice)
                                </td>

                                <td class="text-center">
                                    @item.Quantity
                                </td>

                                <td class="text-end">
                                    <strong>
                                        @Currency.Format(item.Total)
                                    </strong>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="order-total">
                <span>Total</span>

                <strong>
                    @Currency.Format(
                    _order.Items.Sum(x => x.Total))
            </strong>
        </div>
    </section>

    <div class="order-actions">
        <NavLink class="btn btn-outline-primary"
                 href="/orders">
            <i class="bi bi-arrow-left me-2"></i>
            Back to orders
        </NavLink>

        <div class="d-flex flex-wrap gap-2">
            @if (_order.CanBeEdited) {
                    <NavLink class="btn btn-primary"
                             href="@($"/orders/{_order.Id}/edit")">
                        <i class="bi bi-pencil me-2"></i>
                        Edit order
                    </NavLink>
                }

                @if (_order.CanBeCancelled) {
                    <button class="btn btn-danger"
                            @onclick="CancelOrder">
                        <i class="bi bi-x-circle me-2"></i>
                        Cancel order
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OrderDetailsModel? _order;

    protected override async Task OnParametersSetAsync()
    {
        SetBreadcrumbs(
             ("Home", "/"),
             ("Orders", "/orders"),
             ($"Order {Id}", null));

        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        var (order, error) = await ApiClient.GetOrderByIdAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        _order = order;
    }

    private async Task CancelOrder()
    {
        var error = await ApiClient.CancelOrderAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        await LoadOrder();
    }

    private static string GetStatusClass(string status)
    {
        return $"status-badge status-{status.ToLowerInvariant()}";
    }
}