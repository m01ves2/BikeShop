@page "/orders"
@attribute [Authorize]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Orders
@using BikeShop.Blazor.Services.ApiClients.Orders
@using Microsoft.AspNetCore.Authorization


@inject OrdersApiClient ApiClient

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Orders - BikeShop</PageTitle>
<PageHeader Text="My Orders" />

<div class="container my-5">
    @if (_orders is null) {
        <LoadingSpinner />
    }
    else if (_orders.Count == 0) {
        <div class="empty-orders">
            <span class="empty-orders-icon">
                <i class="bi bi-receipt"></i>
            </span>

            <h2>No orders yet</h2>

            <p>
                Your completed orders will appear here.
            </p>

            <NavLink class="btn btn-primary"
                     href="/catalog">
                Explore catalog
            </NavLink>
        </div>
    }
    else {
        <div class="orders-list">
            @foreach (var order in _orders) {
                <article class="order-card card">
                    <div class="row align-items-center g-3">
                        <div class="col-6 col-md-2">
                            <span class="order-label">
                                Order
                            </span>

                            <strong class="order-number">
                                #@order.Id
                            </strong>
                        </div>

                        <div class="col-6 col-md-4">
                            <span class="order-label">
                                Created
                            </span>

                            <span class="order-value">
                                @order.CreatedAt.ToString(
                                "dd.MM.yyyy HH:mm")
                    </span>
                </div>

                <div class="col-7 col-md-3">
                    <span class="@GetStatusClass(order.Status)">
                        @order.Status
                    </span>
                </div>

                <div class="col-5 col-md-3 text-end">
                    <NavLink class="btn btn-outline-primary"
                             href="@($"/orders/{order.Id}")">
                        Details
                        <i class="bi bi-arrow-right ms-1"></i>
                    </NavLink>
                </div>
            </div>
        </article>
                }
        </div>
    }
</div>

@code {
    private List<OrderListItemModel>? _orders;

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"), 
            ("Orders", null));

        var (orders, error) = await ApiClient.GetOrdersAsync();

        if (error is not null) {
            ShowError(error);
            return;
        }

        _orders = orders;
    }

    private static string GetStatusClass(string status)
    {
        return $"status-badge status-{status.ToLowerInvariant()}";
    }
}