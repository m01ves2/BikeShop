@page "/orders/{Id:int}/edit"
@attribute [Authorize]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Orders
@using BikeShop.Blazor.Services.ApiClients.Orders
@using Microsoft.AspNetCore.Authorization


@inject OrdersApiClient ApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Edit Order - BikeShop</PageTitle>
<PageHeader Text="Edit Order" />

<div class="container my-5">
    @if (_model is null) {
        <LoadingSpinner />
    }
    else {
        <section class="edit-order-card card">
            <div class="form-heading">
                <span class="form-icon">
                    <i class="bi bi-truck"></i>
                </span>

                <div>
                    <h2>Delivery details</h2>

                    <p>
                        Update the delivery information for
                        order #@Id.
                    </p>
                </div>
            </div>

            <EditForm Model="_model"
                      OnValidSubmit="UpdateOrderAsync">
                <DataAnnotationsValidator />

                <ValidationSummary class="validation-summary" />

                <div class="mb-4">
                    <label class="form-label"
                           for="delivery-address">
                        Delivery address
                    </label>

                    <InputText id="delivery-address"
                               class="form-control form-control-lg"
                               placeholder="City, street, house and apartment"
                               @bind-Value="_model.DeliveryAddress" />

                    <ValidationMessage For="@(() => _model.DeliveryAddress)" />
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="customer-phone">
                        Customer phone
                    </label>

                    <InputText id="customer-phone"
                               class="form-control form-control-lg"
                               placeholder="+7 (999) 123-45-67"
                               @bind-Value="_model.CustomerPhone" />

                    <ValidationMessage For="@(() => _model.CustomerPhone)" />
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="delivery-date">
                        Delivery date and time
                    </label>

                    <InputDate id="delivery-date"
                               class="form-control form-control-lg"
                               Type="InputDateType.DateTimeLocal"
                               min="@MinDeliveryAt"
                               max="@MaxDeliveryAt"
                               @bind-Value="_model.DeliveryAt" />

                    <div class="form-text">
                        Delivery is available within the next seven days.
                    </div>

                    <ValidationMessage For="@(() => _model.DeliveryAt)" />
                </div>

                <div class="form-actions">
                    <NavLink class="btn btn-outline-secondary"
                             href="@($"/orders/{Id}")"
                             Match="NavLinkMatch.All">
                        Cancel
                    </NavLink>

                    <button class="btn btn-primary"
                            type="submit">
                        <i class="bi bi-check-lg me-2"></i>
                        Save changes
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateOrderModel? _model;

    private string MinDeliveryAt => DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm");

    private string MaxDeliveryAt => DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm");

    protected override async Task OnParametersSetAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Orders", "/orders"),
            ($"Order {Id}", $"/orders/{Id}"),
            ("Edit", null));

        var (order, error) = await ApiClient.GetOrderByIdAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        _model = new UpdateOrderModel
        {
            OrderId = order!.Id,
            DeliveryAddress = order.DeliveryAddress,
            DeliveryAt = order.DeliveryAt,
            CustomerPhone = order.CustomerPhone
        };

    }

    private async Task UpdateOrderAsync()
    {
        var error = await ApiClient.UpdateOrderAsync(_model!);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo($"/orders/{Id}");
    }

}