@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject CategoryApiClient ApiClient

<ErrorToast Message="@errorMessage" />

@if (_categories == null) {
    <PageTitle>BikeShop</PageTitle>
    <LoadingSpinner />
}
else {
    <PageTitle>Categories - BikeShop</PageTitle>
    <PageHeader Text="Categories" />
    <ul>
        @foreach (var category in _categories) {
            <li>
                @category.Name
            </li>
        }
    </ul>
}


@code {

    private List<CategoryListItemModel>? _categories;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var (categories, error) = await ApiClient.GetCategoriesAsync();
        if (error is not null) {
            ShowError(error);
            return;
        }

        _categories = categories;
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}