@page "/categories"
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients

@inject CategoryApiClient ApiClient

<h1>Categories</h1>

@if (categories == null) {
    <p>Loading...</p>
}
else {
    <ul>
        @foreach (var category in categories) {
            <li>
                @category.Name
            </li>
        }
    </ul>
}


@code {

    private List<CategoryListItemModel>? categories;


    protected override async Task OnInitializedAsync()
    {
        categories = await ApiClient.GetCategoriesAsync();
    }

}