@page "/admin/products"
@attribute [Authorize(Roles = "Admin")]

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Admin.Products
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject ProductApiClient ProductApiClient
@inject AdminProductsApiClient AdminApiClient
@inject CurrencyFormatter Currency

<PageTitle>Admin Products - BikeShop</PageTitle>

<ErrorToast Message="@errorMessage" />

<PageHeader Text="Products" />

<div class="container">
    <div class="mb-4">
        <NavLink class="btn btn-primary"
                 href="/admin/products/create">
            Create product
        </NavLink>
    </div>

    @if (_products is null) {
        <LoadingSpinner />
    }
    else {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in _products) {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Name</td>
                            <td>@product.CategoryName</td>
                            <td>@Currency.Format(product.Price)</td>

                            <td class="text-end">
                                <NavLink class="btn btn-outline-primary btn-sm"
                                         href="@($"/admin/products/{product.Id}/edit")">
                                    Edit
                                </NavLink>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteProduct(product.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProductListItemModel>? _products;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var (products, error) =
            await ProductApiClient.GetProductsAsync();

        if (error is not null) {
            ShowError(error);
            return;
        }

        _products = products;
    }

    private async Task DeleteProduct(int id)
    {
        var error = await AdminApiClient.DeleteAsync(id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        await LoadProducts();
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}