@page "/admin/products/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Admin.Products
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Admin.Products
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using BikeShop.Blazor.Services.ProductImages
@using Microsoft.AspNetCore.Authorization


@inject ProductApiClient ProductApiClient
@inject AdminProductsApiClient AdminApiClient
@inject CategoryApiClient CategoryApiClient
@inject NavigationManager Navigation
@inject ProductImageService ProductImages

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Edit Product - BikeShop</PageTitle>
<PageHeader Text="Edit Product" />

<div class="container my-5">
    @if (_model is null || _categories is null) {
        <LoadingSpinner />
    }
    else {
        <section class="admin-form-card product-form card">
            <div class="admin-form-heading">
                <span class="admin-form-icon">
                    <i class="bi bi-pencil"></i>
                </span>

                <div>
                    <h2>Product information</h2>

                    <p>
                        Update product #@_model.Id.
                    </p>
                </div>
            </div>

            <div class="product-images-editor">
                <div class="product-images-heading">
                    <div>
                        <h3>Product images</h3>
                        <p>
                            The first available image is used as the main image.
                            You can store up to 8 WebP images, 5 MB each.
                        </p>
                    </div>

                    <label class="btn btn-outline-primary">
                        <i class="bi bi-plus-lg me-2"></i>
                        Add images

                        <InputFile class="visually-hidden"
                                   accept="image/webp,.webp"
                                   multiple
                                   OnChange="SelectImages" />
                    </label>
                </div>

                @if (_imageUrls.Count == 0 && _newImages.Count == 0) {
                    <div class="product-images-empty">
                        <i class="bi bi-bicycle"></i>
                        <span>No product images</span>
                    </div>
                }
                else {
                    <div class="product-images-grid">
                        @foreach (var imageUrl in _imageUrls) {
                            var isDeleted = _deletedImageUrls.Contains(imageUrl);

                            <article class="product-image-item @(isDeleted ? "deleted" : "")">
                                <div class="product-image-box">
                                    <img src="@imageUrl"
                                         alt="@_model.Name" />

                                    @if (isDeleted) {
                                        <span class="delete-overlay">
                                            Will be deleted
                                        </span>
                                    }
                                </div>

                                <button class="btn @(isDeleted
                                                                                    ? "btn-outline-secondary"
                                                                                    : "btn-outline-danger")"
                            type="button"
                            @onclick="@(() => ToggleImageDeletion(imageUrl))">
                        @if (isDeleted) {
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                        <span>Restore</span>
                                    }
                                    else {
                                        <i class="bi bi-trash me-1"></i>
                                        <span>Delete</span>
                                    }
                                </button>
                            </article>
                        }

                        @foreach (var pendingImage in _newImages) {
                            <article class="product-image-item new">
                                <div class="product-image-box">
                                    <img src="@pendingImage.PreviewUrl"
                                         alt="@pendingImage.File.Name" />

                                    <span class="new-image-label">
                                        New
                                    </span>
                                </div>

                                <button class="btn btn-outline-danger"
                                        type="button"
                                        @onclick="@(() => RemoveNewImage(pendingImage))">
                                    <i class="bi bi-trash me-1"></i>
                                    Remove
                                </button>
                            </article>
                        }
                    </div>
                }

                <p class="product-images-note">
                    Image changes will be applied after you click Save changes.
                </p>
            </div>

            <EditForm Model="_model"
                      OnValidSubmit="UpdateProduct">
                <DataAnnotationsValidator />

                <ValidationSummary class="auth-validation-summary" />

                <div class="mb-4">
                    <label class="form-label"
                           for="product-name">
                        Name
                    </label>

                    <InputText id="product-name"
                               class="form-control form-control-lg"
                               placeholder="Product name"
                               @bind-Value="_model.Name" />

                    <ValidationMessage For="@(() => _model.Name)" />
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="product-description">
                        Description
                    </label>

                    <InputTextArea id="product-description"
                                   class="product-description-input form-control"
                                   rows="8"
                                   placeholder="Detailed product description"
                                   @bind-Value="_model.Description" />

                    <ValidationMessage For="@(() => _model.Description)" />
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label"
                               for="product-price">
                            Price
                        </label>

                        <div class="input-group">
                            <InputNumber id="product-price"
                                         class="form-control form-control-lg"
                                         @bind-Value="_model.Price" />

                            <span class="input-group-text">
                                ₽
                            </span>
                        </div>

                        <ValidationMessage For="@(() => _model.Price)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"
                               for="stock-quantity">
                            Stock quantity
                        </label>

                        <InputNumber id="stock-quantity"
                                     class="form-control form-control-lg"
                                     @bind-Value="_model.StockQuantity" />

                        <ValidationMessage For="@(() => _model.StockQuantity)" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="product-category">
                        Category
                    </label>

                    <InputSelect id="product-category"
                                 class="form-select form-select-lg"
                                 @bind-Value="_model.CategoryId">

                        @foreach (var category in _categories) {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => _model.CategoryId)" />
                </div>

                <div class="admin-form-actions">
                    <NavLink class="btn btn-outline-secondary"
                             href="/admin/products"
                             Match="NavLinkMatch.All">
                        Cancel
                    </NavLink>

                    <button class="btn btn-primary"
                            type="submit">
                        <i class="bi bi-check-lg me-2"></i>
                        Save changes
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateProductModel? _model;
    private List<CategoryListItemModel>? _categories;

    private const int MaxImageCount = 8;
    private const long MaxImageSize = 5 * 1024 * 1024;

    private List<string> _imageUrls = [];
    private readonly HashSet<string> _deletedImageUrls = [];
    private readonly List<PendingImage> _newImages = [];

    protected override async Task OnParametersSetAsync()
    {
        var (product, productError) = await ProductApiClient.GetProductDetailsAsync(Id);

        if (productError is not null) {
            ShowError(productError);
            return;
        }

        var (categories, categoryError) = await CategoryApiClient.GetCategoriesAsync();

        if (categoryError is not null) {
            ShowError(categoryError);
            return;
        }

        _categories = categories;

        _model = new UpdateProductModel
        {
            Id = product!.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            CategoryId = product.CategoryId
        };

        _imageUrls = ProductImages
            .GetImageUrls(_model.Id)
            .ToList();

        _deletedImageUrls.Clear();
        _newImages.Clear();

        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", "/admin"),
            ("Products", "/admin/products"),
            ($"Edit {product.Name}", null));
    }

    private async Task UpdateProduct()
    {
        var error = await AdminApiClient.UpdateAsync(_model!);

        if (error is not null) {
            ShowError(error);
            return;
        }

        try {
            ProductImages.DeleteImages(
                _model!.Id,
                _deletedImageUrls);

            await ProductImages.SaveImagesAsync(
                _model.Id,
                _newImages.Select(image => image.File));
        }
        catch (InvalidOperationException exception) {
            ShowError(exception.Message);
            return;
        }
        catch (IOException) {
            ShowError("The product was updated, but the image changes could not be saved.");
            return;
        }

        Navigation.NavigateTo("/admin/products");
    }

    private async Task SelectImages(InputFileChangeEventArgs eventArgs)
    {
        IReadOnlyList<IBrowserFile> selectedImages;

        try {
            selectedImages = eventArgs.GetMultipleFiles(MaxImageCount);
        }
        catch (InvalidOperationException) {
            ShowError($"You can select no more than {MaxImageCount} images at once.");
            return;
        }

        var remainingExistingImages =
            _imageUrls.Count - _deletedImageUrls.Count;

        if (remainingExistingImages +
            _newImages.Count +
            selectedImages.Count > MaxImageCount) {
            ShowError($"A product can have no more than {MaxImageCount} images.");
            return;
        }

        foreach (var image in selectedImages) {
            if (!image.ContentType.Equals(
                    "image/webp",
                    StringComparison.OrdinalIgnoreCase)) {
                ShowError($"File \"{image.Name}\" is not a WebP image.");
                return;
            }

            if (image.Size > MaxImageSize) {
                ShowError($"File \"{image.Name}\" exceeds the 5 MB limit.");
                return;
            }

            await using var stream =
                image.OpenReadStream(MaxImageSize);

            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var previewUrl =
                $"data:{image.ContentType};base64," +
                Convert.ToBase64String(memoryStream.ToArray());

            _newImages.Add(new PendingImage(image, previewUrl));
        }
    }

    private void ToggleImageDeletion(string imageUrl)
    {
        if (!_deletedImageUrls.Add(imageUrl))
            _deletedImageUrls.Remove(imageUrl);
    }

    private void RemoveNewImage(PendingImage image)
    {
        _newImages.Remove(image);
    }

    private sealed record PendingImage(
        IBrowserFile File,
        string PreviewUrl);

}