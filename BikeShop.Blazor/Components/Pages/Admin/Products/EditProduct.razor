@page "/admin/products/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin")]

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Admin.Products
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Admin.Products
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject ProductApiClient ProductApiClient
@inject AdminProductsApiClient AdminApiClient
@inject CategoryApiClient CategoryApiClient
@inject NavigationManager Navigation

<PageTitle>Edit Product - BikeShop</PageTitle>

<ErrorToast Message="@errorMessage" />

<PageHeader Text="Edit Product" />

<div class="container">
    @if (_model is null || _categories is null) {
        <LoadingSpinner />
    }
    else {
        <EditForm Model="_model"
                  OnValidSubmit="UpdateProduct">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="_model.Description" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <InputNumber class="form-control" @bind-Value="_model.Price" />
            </div>

            <div class="mb-3">
                <label class="form-label">Stock quantity</label>
                <InputNumber class="form-control" @bind-Value="_model.StockQuantity" />
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>

                <InputSelect class="form-select" @bind-Value="_model.CategoryId">
                    @foreach (var category in _categories) {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }
                </InputSelect>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary"
                        type="submit">
                    Save
                </button>

                <NavLink class="btn btn-outline-secondary"
                         href="/admin/products">
                    Cancel
                </NavLink>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateProductModel? _model;
    private List<CategoryListItemModel>? _categories;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var (product, productError) =
            await ProductApiClient.GetProductDetailsAsync(Id);

        if (productError is not null) {
            ShowError(productError);
            return;
        }

        var (categories, categoryError) =
            await CategoryApiClient.GetCategoriesAsync();

        if (categoryError is not null) {
            ShowError(categoryError);
            return;
        }

        _categories = categories;

        _model = new UpdateProductModel
        {
            Id = product!.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            CategoryId = product.CategoryId
        };
    }

    private async Task UpdateProduct()
    {
        var error = await AdminApiClient.UpdateAsync(_model!);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/products");
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}