@page "/admin/products/create"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Admin.Products
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Admin.Products
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using Microsoft.AspNetCore.Authorization


@inject AdminProductsApiClient AdminApiClient
@inject CategoryApiClient CategoryApiClient
@inject NavigationManager Navigation


<ErrorToast Message="@ErrorMessage" />

<PageTitle>Create Product - BikeShop</PageTitle>
<PageHeader Text="Create Product" />

<div class="container my-5">
    @if (_categories is null) {
        <LoadingSpinner />
    }
    else {
        <section class="admin-form-card product-form card">
            <div class="admin-form-heading">
                <span class="admin-form-icon">
                    <i class="bi bi-bicycle"></i>
                </span>

                <div>
                    <h2>Product information</h2>

                    <p>
                        Add a new product to the BikeShop catalog.
                    </p>
                </div>
            </div>

            <EditForm Model="_model"
                      OnValidSubmit="Create">
                <DataAnnotationsValidator />

                <ValidationSummary class="auth-validation-summary" />

                <div class="mb-4">
                    <label class="form-label"
                           for="product-name">
                        Name
                    </label>

                    <InputText id="product-name"
                               class="form-control form-control-lg"
                               placeholder="Product name"
                               @bind-Value="_model.Name" />

                    <ValidationMessage For="@(() => _model.Name)" />
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="product-description">
                        Description
                    </label>

                    <InputTextArea id="product-description"
                                   class="product-description-input form-control"
                                   rows="8"
                                   placeholder="Detailed product description"
                                   @bind-Value="_model.Description" />

                    <ValidationMessage For="@(() => _model.Description)" />
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label"
                               for="product-price">
                            Price
                        </label>

                        <div class="input-group">
                            <InputNumber id="product-price"
                                         class="form-control form-control-lg"
                                         @bind-Value="_model.Price" />

                            <span class="input-group-text">
                                ₽
                            </span>
                        </div>

                        <ValidationMessage For="@(() => _model.Price)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"
                               for="stock-quantity">
                            Stock quantity
                        </label>

                        <InputNumber id="stock-quantity"
                                     class="form-control form-control-lg"
                                     @bind-Value="_model.StockQuantity" />

                        <ValidationMessage For="@(() => _model.StockQuantity)" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label"
                           for="product-category">
                        Category
                    </label>

                    <InputSelect id="product-category"
                                 class="form-select form-select-lg"
                                 @bind-Value="_model.CategoryId">
                        <option value="0">
                            Select category
                        </option>

                        @foreach (var category in _categories) {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="@(() => _model.CategoryId)" />
                </div>

                <div class="admin-form-actions">
                    <NavLink class="btn btn-outline-secondary"
                             href="/admin/products"
                             Match="NavLinkMatch.All">
                        Cancel
                    </NavLink>

                    <button class="btn btn-primary"
                            type="submit">
                        <i class="bi bi-plus-lg me-2"></i>
                        Create product
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    private readonly CreateProductModel _model = new();

    private List<CategoryListItemModel>? _categories;

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", "/admin"),
            ("Products", "/admin/products"),
            ("Create", null));

        var (categories, error) = await CategoryApiClient.GetCategoriesAsync();

        if (error is not null) {
            ShowError(error);
            return;
        }

        _categories = categories;
    }

    private async Task Create()
    {
        var error = await AdminApiClient.CreateAsync(_model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/products");
    }

}