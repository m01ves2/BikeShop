@page "/admin/categories/create"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients.Admin.Categories
@using Microsoft.AspNetCore.Authorization


@inject AdminCategoriesApiClient AdminApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Create Category - BikeShop</PageTitle>
<PageHeader Text="Create Category" />

<div class="container">
    <EditForm Model="_model" OnValidSubmit="Create">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Name</label>

            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">
                Create
            </button>

            <NavLink class="btn btn-outline-secondary" href="/admin/categories">
                Cancel
            </NavLink>
        </div>
    </EditForm>
</div>

@code {
    private readonly CreateCategoryModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", "/"),
            ("Categories", "/"),
            ("Create", null));
    }

    private async Task Create()
    {
        var error = await AdminApiClient.CreateAsync(_model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/categories");
    }

}