@page "/admin/categories/create"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients.Admin.Categories
@using Microsoft.AspNetCore.Authorization


@inject AdminCategoriesApiClient AdminApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Create Category - BikeShop</PageTitle>
<PageHeader Text="Create Category" />

<div class="container my-5">
    <section class="admin-form-card card">
        <div class="admin-form-heading">
            <span class="admin-form-icon">
                <i class="bi bi-tag"></i>
            </span>

            <div>
                <h2>Category information</h2>

                <p>
                    Create a new category for the product catalog.
                </p>
            </div>
        </div>

        <EditForm Model="_model"
                  OnValidSubmit="Create">
            <DataAnnotationsValidator />

            <ValidationSummary class="auth-validation-summary" />

            <div class="mb-4">
                <label class="form-label"
                       for="category-name">
                    Name
                </label>

                <InputText id="category-name"
                           class="form-control form-control-lg"
                           placeholder="Category name"
                           @bind-Value="_model.Name" />

                <ValidationMessage For="@(() => _model.Name)" />
            </div>

            <div class="admin-form-actions">
                <NavLink class="btn btn-outline-secondary"
                         href="/admin/categories"
                         Match="NavLinkMatch.All">
                    Cancel
                </NavLink>

                <button class="btn btn-primary"
                        type="submit">
                    <i class="bi bi-plus-lg me-2"></i>
                    Create category
                </button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    private readonly CreateCategoryModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", "/admin"),
            ("Categories", "/admin/categories"),
            ("Create", null));
    }

    private async Task Create()
    {
        var error = await AdminApiClient.CreateAsync(_model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/categories");
    }

}