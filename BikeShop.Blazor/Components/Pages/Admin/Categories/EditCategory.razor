@page "/admin/categories/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject CategoryApiClient CategoryApiClient
@inject AdminCategoriesApiClient AdminApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Edit Category - BikeShop</PageTitle>
<PageHeader Text="Edit Category" />

<div class="container">
    @if (_model is null) {
        <LoadingSpinner />
    }
    else {
        <EditForm Model="_model" OnValidSubmit="UpdateCategory">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Name</label>

                <InputText class="form-control" @bind-Value="_model.Name" />
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">
                    Save
                </button>

                <NavLink class="btn btn-outline-secondary" href="/admin/categories">
                    Cancel
                </NavLink>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateCategoryModel? _model;

    protected override async Task OnParametersSetAsync()
    {
        var (category, error) = await CategoryApiClient.GetCategoryByIdAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        _model = new UpdateCategoryModel
        {
            Id = category!.Id,
            Name = category.Name
        };
    }

    private async Task UpdateCategory()
    {
        var error = await AdminApiClient.UpdateAsync(_model!);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/categories");
    }

}