@page "/admin/categories/{Id:int}/edit"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients.Admin.Categories
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using Microsoft.AspNetCore.Authorization


@inject CategoryApiClient CategoryApiClient
@inject AdminCategoriesApiClient AdminApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Edit Category - BikeShop</PageTitle>
<PageHeader Text="Edit Category" />

<div class="container my-5">
    @if (_model is null) {
        <LoadingSpinner />
    }
    else {
        <section class="admin-form-card card">
            <div class="admin-form-heading">
                <span class="admin-form-icon">
                    <i class="bi bi-pencil"></i>
                </span>

                <div>
                    <h2>Category information</h2>

                    <p>
                        Update category #@_model.Id.
                    </p>
                </div>
            </div>

            <EditForm Model="_model"
                      OnValidSubmit="UpdateCategory">
                <DataAnnotationsValidator />

                <ValidationSummary class="auth-validation-summary" />

                <div class="mb-4">
                    <label class="form-label"
                           for="category-name">
                        Name
                    </label>

                    <InputText id="category-name"
                               class="form-control form-control-lg"
                               @bind-Value="_model.Name" />

                    <ValidationMessage For="@(() => _model.Name)" />
                </div>

                <div class="admin-form-actions">
                    <NavLink class="btn btn-outline-secondary"
                             href="/admin/categories"
                             Match="NavLinkMatch.All">
                        Cancel
                    </NavLink>

                    <button class="btn btn-primary"
                            type="submit">
                        <i class="bi bi-check-lg me-2"></i>
                        Save changes
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateCategoryModel? _model;

    protected override async Task OnParametersSetAsync()
    {
        var (category, error) = await CategoryApiClient.GetCategoryByIdAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        _model = new UpdateCategoryModel
        {
            Id = category!.Id,
            Name = category.Name
        };

        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", "/admin"),
            ("Categories", "/admin/categories"),
            ($"Edit {category.Name}", null));
    }

    private async Task UpdateCategory()
    {
        var error = await AdminApiClient.UpdateAsync(_model!);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/categories");
    }

}