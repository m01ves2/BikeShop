@page "/admin/orders"
@attribute [Authorize(Roles = "Admin")]

@using BikeShop.Blazor.Components.Shared
@using Microsoft.AspNetCore.Authorization

@inject NavigationManager Navigation

<PageTitle>Admin Orders - BikeShop</PageTitle>
<PageHeader Text="Admin Orders" />

<div class="container">
    <div class="mb-3">
        <label class="form-label">Order ID</label>

        <InputNumber class="form-control" @bind-Value="_orderId" />
    </div>

    <button class="btn btn-primary" @onclick="OpenOrder">
        Open order
    </button>
</div>

@code {
    private int _orderId;

    private void OpenOrder()
    {
        if (_orderId <= 0)
            return;

        Navigation.NavigateTo($"/admin/orders/{_orderId}");
    }
}