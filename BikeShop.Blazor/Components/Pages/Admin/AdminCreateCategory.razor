@page "/admin/categories/create"
@attribute [Authorize(Roles = "Admin")]

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject AdminCategoriesApiClient AdminApiClient
@inject NavigationManager Navigation

<PageTitle>Create Category - BikeShop</PageTitle>

<ErrorToast Message="@errorMessage" />

<PageHeader Text="Create Category" />

<div class="container">
    <EditForm Model="_model"
              OnValidSubmit="CreateCategory">

        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Name</label>

            <InputText class="form-control"
                       @bind-Value="_model.Name" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary"
                    type="submit">
                Create
            </button>

            <NavLink class="btn btn-outline-secondary"
                     href="/admin/categories">
                Cancel
            </NavLink>
        </div>
    </EditForm>
</div>

@code {
    private readonly CreateCategoryModel _model = new();
    private string? errorMessage;

    private async Task CreateCategory()
    {
        var error = await AdminApiClient.CreateAsync(_model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        Navigation.NavigateTo("/admin/categories");
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}