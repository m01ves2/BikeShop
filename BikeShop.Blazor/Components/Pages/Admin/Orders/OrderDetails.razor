@page "/admin/orders/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Admin
@using BikeShop.Blazor.Models.Admin.Orders
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Admin.Orders
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject AdminOrdersApiClient ApiClient
@inject CurrencyFormatter Currency

<ErrorToast Message="@ErrorMessage" />

@if (_order is null) {
    <PageTitle>Admin Order - BikeShop</PageTitle>
    <PageHeader Text="Admin Order" />
    <LoadingSpinner />
}
else {
    <PageTitle>Order #@_order.Id - Admin</PageTitle>
    <PageHeader Text="@($"Order #{_order.Id}")" />

    <div class="container">
        <div class="mb-4">
            <p><strong>Status:</strong> @_order.Status</p>
            <p><strong>Created:</strong> @_order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
            <p><strong>Delivery:</strong> @_order.DeliveryAt.ToString("dd.MM.yyyy HH:mm")</p>
            <p><strong>Address:</strong> @_order.DeliveryAddress</p>
            <p><strong>Customer phone:</strong> @_order.CustomerPhone</p>

            @if (!string.IsNullOrWhiteSpace(_order.CourierPhone)) {
                <p><strong>Courier phone:</strong> @_order.CourierPhone</p>
            }
        </div>

        <h2>Items</h2>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _order.Items) {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@Currency.Format(item.UnitPrice)</td>
                        <td>@item.Quantity</td>
                        <td>@Currency.Format(item.Total)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-end mb-4">
            <strong>
                Total:
                @Currency.Format(_order.Items.Sum(x => x.Total))
            </strong>
        </div>

        @if (_order.AllowedStatuses.Count > 0) {
            <div class="mb-3">
                <label class="form-label">Change status</label>

                <InputSelect class="form-select"
                             @bind-Value="_selectedStatus">
                    @foreach (var status in _order.AllowedStatuses) {
                        <option value="@status">
                            @status
                        </option>
                    }
                </InputSelect>
            </div>

            <button class="btn btn-primary"
                    @onclick="ChangeStatus">
                Change status
            </button>
        }
        else {
            <p class="text-muted">
                No status transitions available.
            </p>
        }

        <div class="mt-4">
            <NavLink class="btn btn-outline-secondary" href="/admin/orders">
                Back
            </NavLink>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OrderDetailsModel? _order;
    private string? _selectedStatus;

    protected override async Task OnParametersSetAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        var (order, error) = await ApiClient.GetOrderByIdAsync(Id);

        if (error is not null) {
            ShowError(error);
            return;
        }

        _order = order;
        _selectedStatus = _order?.AllowedStatuses.FirstOrDefault();
    }

    private async Task ChangeStatus()
    {
        if (_order is null || string.IsNullOrWhiteSpace(_selectedStatus))
            return;

        var model = new ChangeOrderStatusModel
        {
            OrderId = _order.Id,
            OrderStatusDto = _selectedStatus
        };

        var error = await ApiClient.ChangeStatusAsync(model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        await LoadOrder();
    }

}