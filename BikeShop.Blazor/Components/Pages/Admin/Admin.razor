@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inherits BikeShopPageBase

@using Microsoft.AspNetCore.Authorization
@using BikeShop.Blazor.Components.Shared

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Admin - BikeShop</PageTitle>
<PageHeader Text="Admin Panel" />

<div class="container">
    <div class="d-flex gap-3 flex-wrap">
        <NavLink class="btn btn-outline-primary" href="/admin/orders">
            Orders
        </NavLink>

        <NavLink class="btn btn-outline-primary" href="/admin/products">
            Products
        </NavLink>

        <NavLink class="btn btn-outline-primary" href="/admin/categories">
            Categories
        </NavLink>
    </div>
</div>


@code {

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Admin", null));
    }
}