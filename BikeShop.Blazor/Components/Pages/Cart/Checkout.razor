@page "/checkout"
@attribute [Authorize]
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Models.Orders
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Orders
@using BikeShop.Blazor.Services.Models
@using Microsoft.AspNetCore.Authorization

@inject ICartService CartService
@inject OrdersApiClient OrdersApiClient
@inject CurrencyFormatter CurrencyFormatter
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthStateProvider

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Checkout</PageTitle>
<PageHeader Text="Order" />

<div class="container mt-4">
    @if (_orderCreated) {
        <div class="text-center">
            <h2>
                Order created successfully!
            </h2>

            <p>
                Thank you for your order.
            </p>

            @if (_adjustments.Count > 0) {
                <div class="alert alert-warning text-start">
                    <strong>Some cart items were adjusted:</strong>

                    <ul class="mb-0 mt-2">
                        @foreach (var adjustment in _adjustments) {
                            <li>@adjustment</li>
                        }
                    </ul>
                </div>
            }

            <NavLink class="btn btn-primary" href="/orders">
                View orders
            </NavLink>
        </div>
    }
    else if (_loading) {
        <p>Loading...</p>
    }
    else if (_cart is null || !_cart.Items.Any()) {
        <p>Your cart is empty.</p>
    }
    else {
        <div class="row">
            <div class="col-md-7">
                <EditForm Model="_model" OnValidSubmit="CreateOrderAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">
                            Delivery address
                        </label>
                        <InputText class="form-control" @bind-Value="_model.DeliveryAddress" />
                        <ValidationMessage For="@(() => _model.DeliveryAddress)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Customer phone
                        </label>
                        <InputText class="form-control" @bind-Value="_model.CustomerPhone" />
                        <ValidationMessage For="@(() => _model.CustomerPhone)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Delivery date and time
                        </label>

                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="_model.DeliveryAt"
                                   min="@MinDeliveryAt"
                                   max="@MaxDeliveryAt"/>

                        <ValidationMessage For="@(() => _model.DeliveryAt)" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_creating">
                        @(_creating ? "Creating..." : "Create order")
                    </button>

                </EditForm>

            </div>


            <div class="col-md-5">
                <h3>
                    Order
                </h3>
                @foreach (var item in _cart.Items) {
                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            @item.Product.Name × @item.Quantity
                        </span>
                        <span>
                            @CurrencyFormatter.Format(item.Total)
                        </span>
                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between fw-bold">
                    <span>
                        Total
                    </span>
                    <span>
                        @CurrencyFormatter.Format(_cart.Items.Sum(x => x.Total))
                    </span>
                </div>
            </div>
        </div>
    }
</div>


@code {

    private CartModel? _cart;

    private readonly CreateOrderModel _model = new();

    private bool _loading = true;
    private bool _creating;
    private bool _orderCreated = false;

    private readonly List<string> _adjustments = [];

    private string MinDeliveryAt => DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm");

    private string MaxDeliveryAt => DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm");


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (!authState.User.Identity!.IsAuthenticated) {
            Navigation.NavigateTo("/login");
            return;
        }

        var (syncResult, syncError) = await CartService.SynchronizeCartAsync();

        if (syncError is not null) {
            ShowError(syncError);
            return;
        }

        _cart = await CartService.GetLocalCartAsync();

        _loading = false;
    }

    private async Task CreateOrderAsync()
    {
        _creating = true;
        ClearError();
        _adjustments.Clear();

        try {
            var (result, error) = await OrdersApiClient.CreateOrderAsync(_model);

            if (error is not null) {
                ShowError(error);
                return;
            }

            if (result is not null && result.OrderItemAdjustments.Any()) {
                _adjustments.AddRange(result.OrderItemAdjustments);
            }

            await CartService.ClearAsync();

            _cart = new CartModel([]);
            _orderCreated = true;
        }
        finally {
            _creating = false;
        }
    }
}