@page "/cart"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject ICartService CartService
@inject CurrencyFormatter Currency
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Cart - BikeShop</PageTitle>
<PageHeader Text="Your cart" />

<div class="container my-5">
    @if (model.Items.Count == 0) {
        <div class="empty-cart">
            <span class="empty-cart-icon">
                <i class="bi bi-cart3"></i>
            </span>

            <h2>Your cart is empty</h2>

            <p>
                Explore our catalog and find something
                for your next ride.
            </p>

            <NavLink class="btn btn-primary"
                     href="/catalog">
                Explore catalog
            </NavLink>
        </div>
    }
    else {
        <div class="row align-items-start g-4">
            <div class="col-lg-8">
                <div class="cart-items">
                    @foreach (var item in model.Items) {
                        <article class="cart-item card">
                            <div class="row align-items-center g-3">
                                <div class="col-4 col-md-3">
                                    <NavLink href="@($"/product/{item.Product.Id}")"
                                             class="product-image-link">
                                        <div class="product-image">
                                            <i class="bi bi-bicycle"></i>
                                        </div>
                                    </NavLink>
                                </div>

                                <div class="col-8 col-md-4">
                                    <NavLink href="@($"/product/{item.Product.Id}")"
                                             class="product-name">
                                        @item.Product.Name
                                    </NavLink>

                                    <div class="unit-price">
                                        @Currency.Format(item.Product.Price)
                                        each
                                    </div>

                                    @if (item.Product.StockQuantity > 0) {
                                        <span class="stock-status in-stock">
                                            In stock
                                        </span>
                                    }
                                    else {
                                        <span class="stock-status out-of-stock">
                                            Out of stock
                                        </span>
                                    }
                                </div>

                                <div class="col-7 col-md-3">
                                    <div class="quantity-control">
                                        <button type="button"
                                                class="quantity-button"
                                                disabled="@(item.Quantity <= 1)"
                                                aria-label="Decrease quantity"
                                                @onclick="() => Decrease(item)">
                                            <i class="bi bi-dash"></i>
                                        </button>

                                        <span class="quantity-value">
                                            @item.Quantity
                                        </span>

                                        <button type="button"
                                                class="quantity-button"
                                                disabled="@(item.Quantity >= item.Product.StockQuantity)"
                                                aria-label="Increase quantity"
                                                @onclick="() => Increase(item)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-5 col-md-2 text-end">
                                    <strong class="item-total">
                                        @Currency.Format(item.Total)
                                    </strong>

                                    <button type="button"
                                            class="remove-button"
                                            title="Remove product"
                                            aria-label="Remove product"
                                            @onclick="() => Remove(item.Product.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="cart-summary card">
                    <h2>Order summary</h2>

                    <div class="summary-row">
                        <span>Products</span>
                        <span>@model.Items.Sum(x => x.Quantity)</span>
                    </div>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>@Currency.Format(Total)</span>
                    </div>

                    <div class="summary-row">
                        <span>Delivery</span>
                        <span>Calculated at checkout</span>
                    </div>

                    <hr />

                    <div class="summary-total">
                        <span>Total</span>
                        <strong>@Currency.Format(Total)</strong>
                    </div>

                    <AuthorizeView>
                        <Authorized>
                            <NavLink class="btn btn-primary btn-lg w-100"
                                     href="/checkout">
                                Proceed to checkout
                            </NavLink>
                        </Authorized>

                        <NotAuthorized>
                            <NavLink class="btn btn-primary btn-lg w-100"
                                     href="/login">
                                Log in to checkout
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>

                    <NavLink class="continue-link"
                             href="/catalog">
                        <i class="bi bi-arrow-left"></i>
                        Continue shopping
                    </NavLink>
                </aside>
            </div>
        </div>
    }
</div>


@code {
    private CartModel model = new CartModel(new List<CartItemModel>());
    private decimal Total => model.Items.Sum(x => x.Total);

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Cart", null));

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Remove(int productId)
    {
        var error = await CartService.RemoveItemAsync(productId);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Increase(CartItemModel item)
    {
        var error = await CartService.IncreaseItemQuantityAsync(item.Product.Id, 1);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Decrease(CartItemModel item)
    {
        if (item.Quantity <= 1)
            return;

        var error = await CartService.DecreaseItemQuantityAsync(item.Product.Id, 1);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

}