@page "/cart"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization


@inject ICartService CartService
@inject CurrencyFormatter Currency
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Cart</PageTitle>
<PageHeader Text="Cart" />

<div class="container mt-4">

    @if (model.Items.Count == 0) {
        <p>Your cart is empty.</p>
    }
    else {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th style="width:150px">Quantity</th>
                        <th style="width:150px">Stock quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in model.Items) {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">

                                    @* @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                                        <img src="@item.ImageUrl"
                                             width="80"
                                             height="80"
                                             class="me-3 rounded" />
                                    }
                                    else {
                                        <div class="bg-light"
                                             style="width:80px;height:80px">
                                        </div>
                                    } *@

                                    <span>
                                        @item.Product.Name
                                    </span>

                                </div>
                            </td>
                            <td>
                                @Currency.Format(item.Product.Price)
                            </td>
                            <td>
                                <div class="input-group">

                                    <button class="btn btn-outline-secondary" @onclick="() => Decrease(item)">
                                        -
                                    </button>

                                    <input class="form-control text-center" value="@item.Quantity" readonly />

                                    <button class="btn btn-outline-secondary" @onclick="() => Increase(item)">
                                        +
                                    </button>

                                </div>
                            </td>
                            <td>
                            @if (item.Product.StockQuantity > 0) {
                                <small class="text-muted">
                                    In stock: @item.Product.StockQuantity
                                </small>
                            }
                            else {
                                <small class="text-danger">
                                    Out of stock
                                </small>
                            }
                            </td>
                            <td>
                                @Currency.Format(item.Total)
                            </td>
                            <td>
                                <button class="btn btn-danger" @onclick="() => Remove(item.Product.Id)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end">
            <h4>
                Total:
                @Currency.Format(Total)
            </h4>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a class="btn btn-outline-secondary" href="/">
                Continue Shopping
            </a>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="btn btn-primary" href="/checkout">
                        Checkout
                    </NavLink>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="btn btn-primary" href="/login">
                        Login to checkout
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    }
</div>


@code {
    private CartModel model = new CartModel(new List<CartItemModel>());
    private decimal Total => model.Items.Sum(x => x.Total);

    protected override async Task OnInitializedAsync()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Cart", null));

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Remove(int productId)
    {
        var error = await CartService.RemoveItemAsync(productId);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Increase(CartItemModel item)
    {
        var error = await CartService.IncreaseItemQuantityAsync(item.Product.Id, 1);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

    private async Task Decrease(CartItemModel item)
    {
        if (item.Quantity <= 1)
            return;

        var error = await CartService.DecreaseItemQuantityAsync(item.Product.Id, 1);

        if (error != null) {
            ShowError(error);
            return;
        }

        model = await CartService.GetLocalCartAsync();
    }

}