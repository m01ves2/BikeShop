@page "/catalog"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Catalog
@using BikeShop.Blazor.Services.Models

@inject ProductApiClient ApiClient

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Catalog - BikeShop</PageTitle>
<PageHeader Text="Catalog" />

<div class="container my-5">
    @if (_products is null) {
        <LoadingSpinner />
    }
    else if (_products.Count == 0) {
        <p>No products available.</p>
    }
    else {
        <ProductGrid Products="_products" />
    }
</div>

@code {

    private List<ProductListItemModel>? _products;

    protected override async Task OnInitializedAsync()
    {
        var (products, error) = await ApiClient.GetProductsAsync();

        if (error is not null) {

            ShowError(error);
            return;
        }

        _products = products;
    }
}