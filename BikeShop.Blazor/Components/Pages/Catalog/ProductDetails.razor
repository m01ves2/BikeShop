@page "/product/{Id:int}"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Catalog


@inject ProductApiClient ApiClient

<ErrorToast Message="@ErrorMessage" />

@if (model is null) {
    <PageTitle>BikeShop</PageTitle>
    <PageHeader Text="Product details" />
    <LoadingSpinner />
}
else {
    <PageTitle>@model.Name - BikeShop</PageTitle>
    <PageHeader Text="@model.Name" />

    <div class="container my-5">

        <ProductDetailsSection Product="@model" />

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private ProductDetailsModel? model = new();

    protected override async Task OnParametersSetAsync()
    {
        var (product, error) = await ApiClient.GetProductDetailsAsync(Id);
        if (error != null) {
            ShowError(error);
            return;
        }

        model = product;

        if (model is not null) {
            SetBreadcrumbs(
              ("Home", "/"),
              (model.CategoryName, $"/category/{model.CategoryId}"),
              (model.Name, null));
        }
    }
}