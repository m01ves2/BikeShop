@page "/product/{Id:int}"
@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.Models

@inject ProductApiClient ApiClient
@inject BreadcrumbService BreadcrumbService

<ErrorMessage Error="_error" />

@if (_product is null) {
    <PageTitle>BikeShop</PageTitle>
    <LoadingSpinner />
}
else {
    <PageTitle>@_product.Name - BikeShop</PageTitle>
    <PageHeader Text="@_product.Name" />

    <div class="container my-5">

        <ProductDetailsSection Product="@_product" />

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private ProductDetailsModel? _product;
    private ApiErrorResponseModel? _error;

    protected override async Task OnParametersSetAsync()
    {
        var (product, error) = await ApiClient.GetProductDetailsAsync(Id);
        if (error != null) {
            _error = error;
            return;
        }

        //TODO
        if (product is not null) {
            BreadcrumbService.SetItems([
                new()
                {
                    Text = "Home",
                    Url = "/"
                },
                new()
                {
                    Text = product.CategoryName,
                    Url = $"/category/{product.CategoryId}"
                },
                new()
                {
                    Text = product.Name
                }
            ]);
        }
    }

}