@page "/product/{Id:int}"

@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.Models

@inject ProductApiClient ApiClient
@inject BreadcrumbService BreadcrumbService

<ErrorToast Message="@errorMessage" />

@if (model is null) {
    <PageTitle>BikeShop</PageTitle>
    <PageHeader Text="Product details" />
    <LoadingSpinner />
}
else {
    <PageTitle>@model.Name - BikeShop</PageTitle>
    <PageHeader Text="@model.Name" />

    <div class="container my-5">

        <ProductDetailsSection Product="@model" />

    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private ProductDetailsModel? model = new();
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var (product, error) = await ApiClient.GetProductDetailsAsync(Id);
        if (error != null) {
            ShowError(error);
            return;
        }

        model = product;

        //TODO
        if (model is not null) {
            BreadcrumbService.SetItems([
                new()
                {
                    Text = "Home",
                    Url = "/"
                },
                new()
                {
                    Text = product.CategoryName,
                    Url = $"/category/{product.CategoryId}"
                },
                new()
                {
                    Text = product.Name
                }
            ]);
        }
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}