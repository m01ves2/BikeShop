@page "/login"

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services

@inject NavigationManager Navigation
@inject AuthApiClient AuthClient
@inject ITokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthStateProvider

<PageTitle>Login</PageTitle>
<PageHeader Text="Login" />

<div class="container my-5">

    <EditForm Model="model" OnValidSubmit="LoginUser">

        <div class="mb-3">
            <label>Email</label>

            <InputText class="form-control"
                       @bind-Value="model.Email" />
        </div>


        <div class="mb-3">
            <label>Password</label>

            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.Password" />
        </div>


        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="model.RememberMe" />

            <label class="form-check-label">
                Remember me
            </label>
        </div>


        @if (!string.IsNullOrEmpty(errorMessage)) {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }


        <button class="btn btn-primary">
            Login
        </button>

    </EditForm>

</div>


@code {

    private LoginModel model = new();

    private string? errorMessage;


    private async Task LoginUser()
    {
        var (response, error) = await AuthClient.LoginAsync(model);

        if (error is not null) {
            errorMessage = error.Message;
            return;
        }

        await TokenStorage.SaveTokenAsync(response!.Token);

        AuthStateProvider.SignIn(response.Token);

        Navigation.NavigateTo("/");
    }
}