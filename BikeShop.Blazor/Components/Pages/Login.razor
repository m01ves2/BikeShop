@page "/login"

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients

@inject NavigationManager Navigation
@inject AuthApiClient AuthClient
@inject ITokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject ICartService CartService

<PageTitle>Login</PageTitle>
<PageHeader Text="Login" />

<div class="container my-5">

    <EditForm Model="model" OnValidSubmit="LoginUser">
        @* проверка модели, что поля не пустые *@
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" autocomplete="email" @bind-Value="model.Email" />
        </div>


        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" type="password" autocomplete="current-password" @bind-Value="model.Password" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="model.RememberMe" />
            <label class="form-check-label">Remember me</label>
        </div>

        <div class="mt-3">
            Don't have an account?
            <a href="/register">Register</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage)) {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button class="btn btn-primary" disabled="@isLoading">
            @if (isLoading) {
                <span class="spinner-border spinner-border-sm"></span>
                <span>Logging in...</span>
            }
            else {
                <span>Login</span>
            }
        </button>

    </EditForm>

</div>


@code {

    private LoginModel model = new();

    private string? errorMessage;
    private bool isLoading;

    private async Task LoginUser()
    {
        isLoading = true;
        errorMessage = null;

        try {
            var (response, error) = await AuthClient.LoginAsync(model); // получаем token от сервера, если userManager на сервере нашел login+password

            if (error is not null) {
                errorMessage = error.Message;
                return;
            }

            await TokenStorage.SaveTokenAsync(response!.Token); // сохранили токен в localStorage
            
            //наш AuthStateProvider является источником информации о текущем authentication state. превращает JWT в ClaimsPrincipal. 
            // Он берёт JWT, разбирает его claims и создаёт ClaimsPrincipal. 
            // Если JWT валидный и пользователь залогинен, provider возвращает: ClaimsPrincipal.Identity.IsAuthenticated == true. 
            // Если JWT отсутствует/недействителен — anonymous principal.
            AuthStateProvider.SignIn(response.Token);

            // Blazor - компоненты не ходят каждый раз напрямую в JWT.
            // Они работают через: AuthenticationState
            // То есть компонент может получить: AuthenticationState

            // var user = authenticationState.User;
            // user.Identity?.IsAuthenticated
            // или получить claims пользователя.
            // Именно поэтому в UI существуют механизмы вроде: <AuthorizeView>
            // которые позволяют сказать:
            // если authenticated → показать это
            // если anonymous → показать другое
            // После успешной авторизации JwtAuthenticationStateProvider уведомляет Blazor, что authentication state изменился.
            // То есть было: Anonymous,  становится:
            // Authenticated + ClaimsPrincipal + ApplicationUserId

            // Поэтому login фактически:
            // получили JWT → сохранили JWT → provider узнал о новом JWT → создан новый ClaimsPrincipal → AuthenticationState изменился → Blazor узнаёт:
            // "пользователь теперь authenticated"

            var cartSyncResult = await CartService.SynchronizeCartAsync();
            if (cartSyncResult is not null && cartSyncResult.RemovedProductNames.Count > 0) {
                // TODO:
                // показать пользователю RemovedProductNames
                // если они есть
            }

            Navigation.NavigateTo("/");
        }
        finally {
            isLoading = false;
        }
    }
}