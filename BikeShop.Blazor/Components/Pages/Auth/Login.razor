@page "/login"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Identity
@using BikeShop.Blazor.Models.Auth
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Auth


@inject NavigationManager Navigation
@inject AuthApiClient AuthClient
@inject ITokenStorage TokenStorage
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject ICartService CartService

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Login</PageTitle>

<div class="auth-page container">
    <section class="auth-card card">
        <span class="auth-icon">
            <i class="bi bi-person"></i>
        </span>

        <div class="auth-heading">
            <h1>Welcome back</h1>

            <p>
                Log in to view your orders and continue shopping.
            </p>
        </div>

        <EditForm Model="model"
                  OnValidSubmit="LoginUser">
            <DataAnnotationsValidator />

            <ValidationSummary class="auth-validation-summary" />

            <div class="mb-4">
                <label class="form-label"
                       for="login-email">
                    Email
                </label>

                <InputText id="login-email"
                           class="form-control form-control-lg"
                           type="email"
                           autocomplete="email"
                           placeholder="you@example.com"
                           @bind-Value="model.Email" />

                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="mb-4">
                <label class="form-label"
                       for="login-password">
                    Password
                </label>

                <InputText id="login-password"
                           class="form-control form-control-lg"
                           type="password"
                           autocomplete="current-password"
                           placeholder="Enter your password"
                           @bind-Value="model.Password" />

                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div class="form-check mb-4">
                <InputCheckbox id="remember-me"
                               class="form-check-input"
                               @bind-Value="model.RememberMe" />

                <label class="form-check-label"
                       for="remember-me">
                    Remember me
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg w-100"
                    disabled="@isLoading">
                @if (isLoading) {
                    <span class="spinner-border spinner-border-sm me-2"
                          aria-hidden="true">
                    </span>

                    <span>Logging in...</span>
                }
                else {
                    <span>Log in</span>
                }
            </button>
        </EditForm>

        <div class="auth-alternative">
            Don't have an account?

            <NavLink href="/register">
                Create account
            </NavLink>
        </div>
    </section>
</div>


@code {

    private LoginModel model = new();
    private bool isLoading;

    protected override void OnInitialized()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Login", null));
    }

    private async Task LoginUser()
    {
        isLoading = true;
        ClearError();

        try {
            var (response, error) = await AuthClient.LoginAsync(model); // получаем token от сервера, если userManager на сервере нашел login+password

            if (error is not null) {
                ShowError(error);
                return;
            }

            var signedIn = AuthStateProvider.SignIn(response!.Token);
            if (!signedIn) {
                ShowError("The authentication token is expired or invalid.");
                return;
            }

            await TokenStorage.SaveTokenAsync(response!.Token); // сохранили токен в localStorage


            var (cartSyncResult, errorSync) = await CartService.SynchronizeCartAsync();

            if (errorSync is not null) {
                ShowError(errorSync);
                return;
            }

            if (cartSyncResult is not null && cartSyncResult.RemovedProductNames.Count > 0) {
                // TODO:
                // показать пользователю RemovedProductNames
                // если они есть
            }

            Navigation.NavigateTo("/");
        }
        finally {
            isLoading = false;
        }

    }
}