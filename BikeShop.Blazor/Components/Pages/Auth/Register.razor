@page "/register"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Auth
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Auth
@using BikeShop.Blazor.Services.Models

@inject NavigationManager Navigation
@inject AuthApiClient AuthClient

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Register</PageTitle>
<PageHeader Text="Register" />

<div class="container my-5">
    <EditForm Model="model" OnValidSubmit="RegisterUser">

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="model.Email" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" type="password" @bind-Value="model.Password" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage)) {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <button class="btn btn-primary">
            Register
        </button>

    </EditForm>
</div>

@code {
    private RegisterModel model = new();

    protected override void OnInitialized()
    {
        SetBreadcrumbs(
            ("Home", "/"),
            ("Register", null));
    }

    private async Task RegisterUser()
    {
        var error = await AuthClient.RegisterAsync(model);

        if (error is not null) {
            ShowError(error);
            return;
        }

        // success
        Navigation.NavigateTo("/");
    }
}