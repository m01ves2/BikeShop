@page "/profile"
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services.ApiClients
@using System.Net
@using BikeShop.Blazor.Services.Models

@inject AuthApiClient ApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@errorMessage" />

<PageTitle>Profile</PageTitle>
<PageHeader Text="Profile" />

@if (model is null || string.IsNullOrEmpty(model.Email)) {
    <p>Loading...</p>
}
else {
    <p>Hello @model.Email</p>
}

@code
{
    private CurrentUserModel? model = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try {
            var(result, error) = await ApiClient.GetCurrentUserAsync();
            if (error != null) {
                ShowError(error);
                return;
            }

            model = result!;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized) {
            Navigation.NavigateTo("/login");
        }
    }

    private void ShowError(ApiErrorResponseModel error)
    {
        errorMessage = error.Message;
    }
}