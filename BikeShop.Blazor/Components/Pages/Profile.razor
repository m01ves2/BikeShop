@page "/profile"
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services.ApiClients
@using System.Net
@using BikeShop.Blazor.Services.Models

@inject AuthApiClient ApiClient
@inject NavigationManager Navigation

<h3>Profile</h3>

@if (_user is null || string.IsNullOrEmpty(_user.Email)) {
    <p>Loading...</p>
}
else {
    <p>Hello @_user.Email</p>
}

@code
{
    private CurrentUserModel? _user;
    private ApiErrorResponseModel? _error;

    protected override async Task OnInitializedAsync()
    {
        try {
            var(result, error) = await ApiClient.GetCurrentUserAsync();
            if (error != null) {
                _error = error;
                return;
            }

            _user = result!;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized) {
            Navigation.NavigateTo("/login");
        }
    }
}