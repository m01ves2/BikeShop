@page "/profile"
@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Auth
@using BikeShop.Blazor.Services.ApiClients.Auth
@using System.Net


@inject AuthApiClient ApiClient
@inject NavigationManager Navigation

<ErrorToast Message="@ErrorMessage" />

<PageTitle>Profile - BikeShop</PageTitle>
<PageHeader Text="My account" />

<div class="container my-5">
    @if (model is null || string.IsNullOrEmpty(model.Email)) {
        <LoadingSpinner />
    }
    else {
        <section class="profile-card card">
            <span class="profile-icon">
                <i class="bi bi-person"></i>
            </span>

            <div class="profile-heading">
                <h2>Profile</h2>

                <p>
                    Your BikeShop account information.
                </p>
            </div>

            <div class="profile-field">
                <span class="profile-label">
                    Email
                </span>

                <strong>
                    @model.Email
                </strong>
            </div>

            <div class="profile-actions">
                <NavLink class="btn btn-primary"
                         href="/orders">
                    <i class="bi bi-receipt me-2"></i>
                    View orders
                </NavLink>

                <NavLink class="btn btn-outline-primary"
                         href="/logout">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Log out
                </NavLink>
            </div>
        </section>
    }
</div>

@code
{
    private CurrentUserModel? model = new();

    protected override async Task OnInitializedAsync()
    {
        try {
            SetBreadcrumbs(
                ("Home", "/"),
                ("Profile", null));

            var (result, error) = await ApiClient.GetCurrentUserAsync();
            if (error != null) {
                ShowError(error);
                return;
            }

            model = result!;

        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized) {
            Navigation.NavigateTo("/login");
        }
    }

}