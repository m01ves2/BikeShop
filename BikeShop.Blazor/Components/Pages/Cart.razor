@page "/cart"

@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services

@inject ICartService CartService
@inject CurrencyFormatter Currency

<div class="container mt-4">
    <div class="mb-4">
        <h1>Shopping Cart</h1>
    </div>

    @if (cart.Items.Count == 0) {
        <p>Your cart is empty.</p>
    }
    else {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th style="width:150px">Quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in cart.Items) {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">

                                    @* @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                                        <img src="@item.ImageUrl"
                                             width="80"
                                             height="80"
                                             class="me-3 rounded" />
                                    }
                                    else {
                                        <div class="bg-light"
                                             style="width:80px;height:80px">
                                        </div>
                                    } *@

                                    <span>
                                        @item.Product.Name
                                    </span>

                                </div>
                            </td>
                            <td>
                                @Currency.Format(item.Product.Price)
                            </td>
                            <td>
                                <div class="input-group">

                                    <button class="btn btn-outline-secondary"
                                            @onclick="() => Decrease(item)">
                                        -
                                    </button>


                                    <input class="form-control text-center"
                                           value="@item.Quantity"
                                           readonly />


                                    <button class="btn btn-outline-secondary"
                                            @onclick="() => Increase(item)">
                                        +
                                    </button>

                                </div>
                            </td>
                            <td>
                                @Currency.Format(item.Total)
                            </td>
                            <td>
                                <button class="btn btn-danger" @onclick="() => Remove(item.Product.Id)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end">
            <h4>
                Total:
                @Currency.Format(Total)
            </h4>
        </div>

        <div class="d-flex justify-content-between mt-4">

            <a class="btn btn-outline-secondary"
               href="/">
                Continue Shopping
            </a>


            <button class="btn btn-primary">
                Checkout
            </button>

        </div>
    }
</div>


@code {
    private CartModel cart = new CartModel(new List<CartItemModel>());
    private decimal Total => cart.Items.Sum(x => x.Total);

    protected override async Task OnInitializedAsync()
    {
        cart = await CartService.GetCartAsync();
    }

    private async Task Remove(int id)
    {
        await CartService.RemoveItemAsync(id);

        cart = await CartService.GetCartAsync();
    }

    private async Task Increase(CartItemModel item)
    {
        item.Quantity++;

        await CartService.UpdateQuantityAsync(
            item.Product.Id,
            item.Quantity);

        cart = await CartService.GetCartAsync();
    }

    private async Task Decrease(CartItemModel item)
    {
        if (item.Quantity <= 1) {
            return;
        }

        item.Quantity--;

        await CartService.UpdateQuantityAsync(
            item.Product.Id,
            item.Quantity);

        cart = await CartService.GetCartAsync();
    }
}