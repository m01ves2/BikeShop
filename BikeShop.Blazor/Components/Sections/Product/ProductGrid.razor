@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients

@inject ProductApiClient ApiClient


@if( Products is null)
{
    <LoadingSpinner />
}
else
{
    <div class="row g-4">

        @foreach (var product in Products) {
            <div class="col-12 col-md-6 col-lg-4 col-xl-3">

                <ProductCard Product="product" />

            </div>
        }

    </div>
}


@code {
    [Parameter]
    public required IReadOnlyList<ProductListItemModel> Products { get; set; }
}