@using System.Globalization
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services

@inject CurrencyFormatter Currency
@inject ICartService CartService

@if (Product is null)
{
    <LoadingSpinner />
}
else
{
    <div class="row">

        <div class="col-lg-6">
            <div class="border rounded bg-light d-flex justify-content-center align-items-center" style="height:350px;">
                <span class="text-muted">
                    Product Image
                </span>
            </div>
        </div>

        <div class="col-lg-6">
            <h3 class="text-primary">
                @Currency.Format(Product.Price)
            </h3>
            <p>
                @Product.Description
            </p>
            <p>
                <strong>In stock:</strong>
                @Product.StockQuantity
            </p>
            <button class="btn btn-primary btn-lg" @onclick="AddToCart">
                Add to Cart
            </button>
        </div>

    </div>
}

@code {

    [Parameter]
    public ProductDetailsModel? Product { get; set; }

    private async Task AddToCart()
    {
        var item = new CartItemModel
        {
            Id = 0, //no need
            Quantity = 1,
            Product = new ProductCartModel(Product.Id, Product.Name, Product.Price, 100),
        };

        await CartService.AddItemAsync(item);
    }
}