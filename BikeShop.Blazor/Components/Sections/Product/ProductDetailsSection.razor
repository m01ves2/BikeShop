@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ProductImages

@inject CurrencyFormatter Currency
@inject ICartService CartService
@inject ProductImageService ProductImages

@if (Product is null) {
    <LoadingSpinner />
}
else {
    <section class="product-details">
        <div class="row align-items-start g-5">
            @* изображение занимает 7/12, а информация 5/12 *@
            <div class="col-lg-7">
                <div class="product-image">
                    @if (_selectedImageUrl is not null) {
                        <img src="@_selectedImageUrl"
                             alt="@Product.Name" />
                    }
                    else {
                        <div class="product-placeholder">
                            <i class="bi bi-bicycle"></i>
                            <span>Product image</span>
                        </div>
                    }
                </div>

                @if (_imageUrls.Count > 1) {
                    <div class="product-thumbnails">
                        @for (var index = 0; index < _imageUrls.Count; index++) {
                            var imageUrl = _imageUrls[index];
                            var imageNumber = index + 1;

                            <button class="product-thumbnail @(_selectedImageUrl == imageUrl ? "active" : "")"
                                    type="button"
                                    @onclick="@(() => SelectImage(imageUrl))">
                                <img src="@imageUrl"
                                     alt="@($"{Product.Name}, image {imageNumber}")" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-5">
                <NavLink class="product-category"
                         href="@($"/category/{Product.CategoryId}")">
                    @Product.CategoryName
                </NavLink>

                <h1 class="product-name">
                    @Product.Name
                </h1>

                <div class="product-price">
                    @Currency.Format(Product.Price)
                </div>

                @if (Product.StockQuantity > 0) {
                    <div class="availability in-stock">
                        <i class="bi bi-check-circle-fill"></i>
                        In stock
                    </div>
                }
                else {
                    <div class="availability out-of-stock">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        Out of stock
                    </div>
                }

                <hr class="product-divider" />

                <div class="product-description">
                    <h2>Description</h2>

                    <p>
                        @Product.Description
                    </p>
                </div>

                @if (Product.StockQuantity > 0) {
                    <p class="stock-quantity">
                        Available: @Product.StockQuantity
                    </p>
                }

                <button class="product-button btn btn-primary btn-lg w-100"
                        disabled="@(Product.StockQuantity <= 0)"
                        @onclick="AddToCart">
                    <i class="bi bi-cart-plus me-2"></i>

                    @if (Product.StockQuantity > 0) {
                        <span>Add to cart</span>
                    }
                    else {
                        <span>Out of stock</span>
                    }
                </button>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public ProductDetailsModel? Product { get; set; }

    private IReadOnlyList<string> _imageUrls = [];
    private string? _selectedImageUrl;
    private int? _loadedProductId;

    private async Task AddToCart()
    {
        var item = new CartItemModel
        {
            Id = 0,
            Quantity = 1,
            Product = new ProductCartModel(
                Product!.Id,
                Product.Name,
                Product.Price,
                Product.StockQuantity),
        };

        await CartService.AddItemAsync(item);
    }

    protected override void OnParametersSet()
    {
        if (Product is null || Product.Id == _loadedProductId)
            return;

        _loadedProductId = Product.Id;
        _imageUrls = ProductImages.GetImageUrls(Product.Id);
        _selectedImageUrl = _imageUrls.FirstOrDefault();
    }

    private void SelectImage(string imageUrl)
    {
        _selectedImageUrl = imageUrl;
    }
}