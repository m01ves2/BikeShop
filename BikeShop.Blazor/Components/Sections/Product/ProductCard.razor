@using BikeShop.Blazor.Models
@using System.Globalization
@using BikeShop.Blazor.Services

@inject CurrencyFormatter Currency

<NavLink href=@($"/product/{Product.Id}") class="text-decoration-none text-dark">
    <div class="card h-100 shadow-sm">

        <div class="card-body">
            <h5 class="card-title">
                @Product.Name
            </h5>
            @* <p class="card-text text-muted">
            @Product.Description
        </p> *@
        </div>
        @* <ProductImage ImageUrl=@($"/images/products/{Product.Id}.jpg") Alt=@($"{Product.Name}") CssClass="card-img-top" /> *@

        <div class="border-top border-bottom bg-light d-flex justify-content-center align-items-center" style="height:220px;">
            <span class="text-muted">
                Product Image
            </span>
            @* <img ... /> *@
        </div>

        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <strong>@Currency.Format(Product.Price)</strong>

                <NavLink class="btn btn-primary btn-sm" href="@($"/product/{Product.Id}")">
                    View
                </NavLink>
            </div>
        </div>

    </div>
</NavLink>

@code
{
    [Parameter]
    public required ProductListItemModel Product { get; set; }
}