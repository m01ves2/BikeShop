@using BikeShop.Blazor.Models

<div class="card h-100 shadow-sm">

    <div class="card-body">
        <h5 class="card-title">
            @Product.Name
        </h5>
        @* <p class="card-text text-muted">
            @Product.Description
        </p> *@
    </div>

    <div class="card-footer bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <strong>@Product.Price.ToString("C")</strong>

            <NavLink class="btn btn-primary btn-sm" href="@($"/product/{Product.Id}")">
                View
            </NavLink>
        </div>
    </div>

</div>

@code
{
    [Parameter]
    public required ProductListItemModel Product { get; set; }
}