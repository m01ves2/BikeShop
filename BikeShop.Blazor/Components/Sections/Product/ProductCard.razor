@using System.Globalization
@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services

@inject CurrencyFormatter Currency
@inject ICartService CartService

<div class="card h-100 shadow-sm d-flex flex-column">
    <NavLink href="@($"/product/{Product.Id}")"
             class="text-decoration-none text-dark d-flex flex-column flex-grow-1">

        <div class="card-body flex-grow-1">
            <h5 class="card-title">
                @Product.Name
            </h5>
        </div>

        <div class="border-top border-bottom bg-light d-flex justify-content-center align-items-center"
             style="height: 220px;">
            <span class="text-muted">
                Product Image
            </span>
        </div>

        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <strong>@Currency.Format(Product.Price)</strong>
            </div>
        </div>
    </NavLink>

    <button class="btn btn-primary" @onclick="AddToCart">
        Add to cart
    </button>
</div>

@code
{
    [Parameter]
    public required ProductListItemModel Product { get; set; }

    private async Task AddToCart()
    {
        var item = new CartItemModel
        {
            Id = 0, //no need
            Quantity = 1,
            Product = new ProductCartModel(Product.Id, Product.Name, Product.Price, Product.StockQuantity),
        };

        await CartService.AddItemAsync(item);
    }
}