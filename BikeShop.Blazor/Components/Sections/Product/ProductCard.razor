@using BikeShop.Blazor.Models.Cart
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services

@inject CurrencyFormatter Currency
@inject ICartService CartService

<div class="product-card card h-100">
    <NavLink href="@($"/product/{Product.Id}")"
             class="product-link d-flex flex-column flex-grow-1">

        <div class="product-image">
            @if (Product.StockQuantity <= 0) {
                <span class="product-badge">
                    Out of stock
                </span>
            }

            <div class="product-placeholder">
                <i class="bi bi-bicycle"></i>
                <span>Product image</span>
            </div>
        </div>

        <div class="card-body d-flex flex-column">
            <span class="product-category">
                @Product.CategoryName
            </span>

            <h5 class="product-title">
                @Product.Name
            </h5>

            <div class="product-meta mt-auto pt-3">
                <strong class="product-price">
                    @Currency.Format(Product.Price)
                </strong>

                @if (Product.StockQuantity > 0) {
                    <span class="product-stock in-stock">
                        In stock
                    </span>
                }
                else {
                    <span class="product-stock out-of-stock">
                        Unavailable
                    </span>
                }
            </div>
        </div>
    </NavLink>

    <div class="card-footer product-actions">
        <button class="product-button btn btn-primary w-100"
                disabled="@(Product.StockQuantity <= 0)"
                @onclick="AddToCart">
            <i class="bi bi-cart-plus me-2"></i>

            @if (Product.StockQuantity > 0) {
                <span>Add to cart</span>
            }
            else {
                <span>Out of stock</span>
            }
        </button>
    </div>
</div>

@code
{
    [Parameter]
    public required ProductListItemModel Product { get; set; }

    private async Task AddToCart()
    {
        var item = new CartItemModel
        {
            Id = 0, //no need
            Quantity = 1,
            Product = new ProductCartModel(Product.Id, Product.Name, Product.Price, Product.StockQuantity),
        };

        await CartService.AddItemAsync(item);
    }
}