@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Catalog

@inject ProductApiClient ApiClient

<ErrorToast Message="@_errorMessage" />

<section class="container py-5">

    <SectionTitle Text="Featured Products" />

    @if (_products is null) {
        <LoadingSpinner />
    }
    else {
        <ProductGrid Products="_products" />
    }

</section>

@code 
{
    private IReadOnlyList<ProductListItemModel>? _products;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var (products, error) = (await ApiClient.GetProductsAsync());
        if (error != null) {
            _errorMessage = error.Message;
            return;
        }

        _products = products!.Take(4).ToList();
    }
}