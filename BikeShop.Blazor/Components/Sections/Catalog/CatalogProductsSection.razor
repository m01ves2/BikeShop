@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.Models

@inject ProductApiClient ApiClient


@if (_products is null)
{
    <LoadingSpinner />
}
else
{
    <div class="container my-5">
        <ProductGrid Products="_products" />
    </div>
}


@code {

    [Parameter]
    public int CategoryId { get; set; }

    private IReadOnlyList<ProductListItemModel>? _products;
    private ApiErrorResponseModel? _error;

    protected override async Task OnParametersSetAsync()
    {
        var (products, error) =  await ApiClient.GetProductsByCategoryAsync(CategoryId);
        if (error != null) {
            _error = error;
            return;
        }

        _products = products;
    }

}