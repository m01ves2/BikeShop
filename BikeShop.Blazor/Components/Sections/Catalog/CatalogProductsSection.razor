@using BikeShop.Blazor.Components.Sections.Product
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Catalog

@inject ProductApiClient ApiClient

<ErrorToast Message="@_errorMessage" />

@if (_products is null) {
    <LoadingSpinner />
}
else {
    <div class="container my-5">
        <ProductGrid Products="_products" />
    </div>
}


@code {

    [Parameter]
    public int CategoryId { get; set; }

    private List<ProductListItemModel>? _products;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var (products, error) =  await ApiClient.GetProductsByCategoryAsync(CategoryId);
        if (error != null) {
            _errorMessage = error.Message;
            return;
        }

        _products = products;
    }

}