@using BikeShop.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization

@implements IDisposable

@inject ICartService CartService

<header class="site-header sticky-top">
    <nav class="navbar container py-3">
        <NavLink class="navbar-brand d-flex align-items-center gap-2 fw-bold m-0"
                 href="/"
                 Match="NavLinkMatch.All">
            <span class="brand-icon">
                <i class="bi bi-bicycle"></i>
            </span>

            BikeShop
        </NavLink>

        <div class="d-flex align-items-center gap-2">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink class="btn btn-light"
                             href="/admin"
                             title="Admin panel">
                        <i class="bi bi-gear"></i>
                        <span class="d-none d-lg-inline ms-1">
                            Admin
                        </span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="btn btn-light"
                             href="/orders"
                             title="Orders">
                        <i class="bi bi-receipt"></i>
                        <span class="d-none d-lg-inline ms-1">
                            Orders
                        </span>
                    </NavLink>

                    <NavLink class="btn btn-light"
                             href="/profile"
                             title="Profile">
                        <i class="bi bi-person"></i>
                        <span class="d-none d-lg-inline ms-1">
                            Profile
                        </span>
                    </NavLink>

                    <NavLink class="btn btn-light"
                             href="/logout"
                             title="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </NavLink>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="btn btn-outline-primary"
                             href="/register">
                        Register
                    </NavLink>

                    <NavLink class="btn btn-primary"
                             href="/login">
                        Log in
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>

            <NavLink class="btn cart-button d-flex align-items-center gap-2"
                     href="/cart"
                     title="Cart">
                <i class="bi bi-cart3"></i>

                @if (cartCount > 0) {
                    <span class="cart-count">
                        @cartCount
                    </span>
                }
            </NavLink>
        </div>
    </nav>
</header>


@code {
    private int cartCount;

    protected override void OnInitialized()
    {
        CartService.CartChanged += UpdateCartCount;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            await LoadCartCount();
            StateHasChanged();
        }
    }

    private async void UpdateCartCount(object? sender, EventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await LoadCartCount();
            await InvokeAsync(StateHasChanged);
        });
    }


    private async Task LoadCartCount()
    {
        var cart = await CartService.GetLocalCartAsync();

        cartCount = cart.Items.Sum(x => x.Quantity);
    }

    public void Dispose()
    {
        CartService.CartChanged -= UpdateCartCount;
    }
}