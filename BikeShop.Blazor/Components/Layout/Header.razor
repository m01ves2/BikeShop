@using BikeShop.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization

@implements IDisposable
@inject ICartService CartService

<header class="sticky-top border-top border-bottom bg-white shadow-sm">

    <nav class="navbar container">

        <NavLink class="navbar-brand fw-bold" href="/">
            <i class="bi bi-bicycle"></i>
            BikeShop
        </NavLink>

        <div class="d-flex align-items-center gap-3">

            <NavLink class="text-dark text-decoration-none fs-5" href="/search">
                <i class="bi bi-search"></i>
            </NavLink>

            @* <NavLink class="text-dark text-decoration-none fs-5" href="/account">
                <i class="bi bi-person"></i>
            </NavLink> *@

            <AuthorizeView>

                <Authorized>

                    <span class="me-2">
                        Hello, @context.User.Identity?.Name
                    </span>

                    <NavLink class="text-dark text-decoration-none fs-5" href="/logout">
                        <i class="bi bi-box-arrow-right"></i>
                    </NavLink>

                    <NavLink class="text-dark text-decoration-none fs-5" href="/profile">
                        <i class="bi bi-person-fill"></i>
                    </NavLink>
                </Authorized>

                <NotAuthorized>

                    <NavLink class="text-dark text-decoration-none fs-5"
                             href="/register">
                        <i class="bi bi-person-plus"></i>
                    </NavLink>

                    <NavLink class="text-dark text-decoration-none fs-5 ms-2"
                             href="/login">
                        <i class="bi bi-box-arrow-in-right"></i>
                    </NavLink>

                </NotAuthorized>

            </AuthorizeView>

            <NavLink class="cart-link text-dark text-decoration-none" href="/cart">

                <i class="bi bi-cart3 fs-5"></i>

                <span class="cart-badge badge rounded-pill bg-danger">
                    @if (cartCount > 0) {
                        <span>
                            (@cartCount)
                        </span>
                    }
                </span>

            </NavLink>

        </div>

    </nav>

</header>


@code {
    private int cartCount;

    protected override void OnInitialized()
    {
        CartService.CartChanged += UpdateCartCount;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            await LoadCartCount();
            StateHasChanged();
        }
    }

    private async void UpdateCartCount(object? sender, EventArgs e)
    {
        await InvokeAsync(async () =>
        {
            await LoadCartCount();
            await InvokeAsync(StateHasChanged);
        });
    }


    private async Task LoadCartCount()
    {
        var cart = await CartService.GetLocalCartAsync();

        cartCount = cart.Items.Sum(x => x.Quantity);
    }

    public void Dispose()
    {
        CartService.CartChanged -= UpdateCartCount;
    }
}