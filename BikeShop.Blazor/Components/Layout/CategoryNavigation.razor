@inherits BikeShopPageBase

@using BikeShop.Blazor.Components.Pages
@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services
@using BikeShop.Blazor.Services.ApiClients
@using BikeShop.Blazor.Services.ApiClients.Catalog

@inject CategoryApiClient ApiClient

<nav class="border-bottom bg-white">

    <div class="container">

        @if (model is null) {
            @* <div class="text-center py-2">
                <div class="spinner-border spinner-border-sm"></div>
            </div> *@
            <LoadingSpinner />
        }
        else {
            <ul class="nav justify-content-center flex-wrap py-2">

                @foreach (var category in model) {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/category/{category.Id}")">
                            @category.Name
                        </NavLink>
                    </li>
                }

            </ul>
        }

    </div>

</nav>

@code
{
    private IReadOnlyList<CategoryListItemModel>? model;

    protected override async Task OnInitializedAsync()
    {
        var (categories, error) = await ApiClient.GetCategoriesAsync();
        if (error is not null) {
            ShowError(error);
            return;
        }

        model = categories;
    }
}