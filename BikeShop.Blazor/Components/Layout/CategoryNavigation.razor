@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models.Catalog
@using BikeShop.Blazor.Services.ApiClients.Catalog

@inject CategoryApiClient ApiClient

<ErrorToast Message="@_errorMessage" />

<nav class="category-navigation">
    <div class="container">
        @if (model is null) {
            <LoadingSpinner />
        }
        else {
            <ul class="category-list nav justify-content-center flex-wrap">
                @foreach (var category in model) {
                    <li class="nav-item">
                        <NavLink class="category-link nav-link"
                                 href="@($"/category/{category.Id}")">
                            @category.Name
                        </NavLink>
                    </li>
                }
            </ul>
        }
    </div>
</nav>

@code
{
    private IReadOnlyList<CategoryListItemModel>? model;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var (categories, error) = await ApiClient.GetCategoriesAsync();
        if (error is not null) {
            _errorMessage = error.Message;
            return;
        }

        model = categories;
    }
}