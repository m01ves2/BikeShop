@using BikeShop.Blazor.Components.Shared
@using BikeShop.Blazor.Models
@using BikeShop.Blazor.Services

@inject CategoryApiClient ApiClient

<nav class="border-bottom bg-white">

    <div class="container">

        @if (categories is null) {
            @* <div class="text-center py-2">
                <div class="spinner-border spinner-border-sm"></div>
            </div> *@
            <LoadingSpinner />
        }
        else {
            <ul class="nav justify-content-center flex-wrap py-2">

                @foreach (var category in categories) {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="@($"/category/{category.Id}")">
                            @category.Name
                        </NavLink>
                    </li>
                }

            </ul>
        }

    </div>

</nav>

@code
{
    private IReadOnlyList<CategoryListItemModel>? categories;

    protected override async Task OnInitializedAsync()
    {
        categories = await ApiClient.GetCategoriesAsync();
    }
}